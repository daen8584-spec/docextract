# PostgreSQL connection for the application and the worker
DATABASE_URL="postgresql://USER@localhost:5432/docextract"

# Any OpenAI-compatible chat completions endpoint (Groq, OpenRouter, LiteLLM, llama.cpp)
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY=""
LLM_MODEL=""
LLM_TIMEOUT_MS="60000"

# Optional. Defaults to DATABASE_URL with the database name changed to docextract_test.
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/docextract_test"

# Number of proxies in front of the app that append to X-Forwarded-For. Enables
# per-address rate limits; leave at 0 when the app is reachable directly.
TRUSTED_PROXY_HOPS="0"

# trace, debug, info, warn, error, fatal or silent
LOG_LEVEL="info"
